# 复制成 .env(或在启动前 export)后按自己的环境改。
# 仓库里没有任何默认口令 —— 不配就用不了,这是刻意的。

# ---- PostgreSQL(主库)----
PG_DSN=host=127.0.0.1 port=5432 user=postgres password=改成你的口令 dbname=daxy_cognitive_db

# ---- MySQL(仅老数据迁移时用,日常不需要)----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=daxy_cognitive_db

# ---- 仪表盘登录与监听 ----
# 不设 DASH_PASS 时每次启动随机生成一个,并打印在日志里。
DASH_USER=root
DASH_PASS=
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ---- gRPC ----
GRPC_PORT=9999
GRPC_TARGET=127.0.0.1:9999

# ---- 运行环境路径(可选,不需要就整行留着注释掉)----
# 不配就用当前解释器。
#BRAIN_PYTHON=
# Windows 上让 run.py 能自己拉起 PostgreSQL(两个都要配才生效)
#PGSQL_BIN=
#PGSQL_DATA=
# Whisper 语音转写要 ffmpeg
#FFMPEG_DIR=

# ---- 爬虫 ----
# 国际源(维基/arXiv/DDG)走的代理,默认 http://127.0.0.1:7890。
# 注意必须写成 http://,对着明文 HTTP 端口发 https:// 会 TLS 握手失败,
# 整批国际源静默全灭且不留日志。置空则直连。
CRAWLER_INTL_PROXY=http://127.0.0.1:7890

# ---- 思维链守护(可选)----
# 方式一:配置兼容 OpenAI /v1/chat/completions 的推理端点(直接用内置 scripts/thinking_daemon.py)
#THINKING_LLM_URL=http://127.0.0.1:8010/v1/chat/completions
#THINKING_LLM_MODEL=Qwen3.6-35B-A3B
#THINKING_LLM_API_KEY=
# 方式二:指定外部 Python 环境与脚本(两个都配上才会被 run.py 拉起,否则自动跳过)
#THINKING_PYTHON=
#THINKING_DAEMON=
#THINKING_LOG=
# 阈值标定用的同域难负例语料(jsonl)
#THINKING_HELDOUT=
